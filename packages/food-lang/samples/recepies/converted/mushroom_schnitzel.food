//mushroom_schnitzel.food

// Ingredients
schnitzels = new Schnitzel("2 pieces")
lemon_juice = new LemonJuice("fresh")
mushrooms = new Mushroom("125-150g, fresh")
oil = new Oil("for frying")
salt = new Salt("to taste")
flour = new Flour("for dusting")
cream = new Cream("125ml")
white_wine = new WhiteWine("2 tbsp")

// Utensils
meat_mallet = new MeatMallet()
knife = new Knife()
pan = new Pan()

fn prepareIngredients() {
    // Preparation
    meat_mallet.pound(schnitzels, "until thin")
    sprinkle(schnitzels, lemon_juice)
    
    knife.slice(mushrooms)
    sprinkle(mushrooms, lemon_juice)
}

fn cook() {
    prepareIngredients()
    
    // Cooking mushrooms
    pan.heat("medium-high")
    pan.add(oil)
    pan.add(mushrooms)
    pan.fry("until golden")
    pan.remove(mushrooms)
    
    // Cooking schnitzels
    pan.add(schnitzels)
    pan.fry("6-10 minutes, turning once")
    season(schnitzels, salt)
    
    // Make sauce
    sprinkle(flour, schnitzels)
    pan.add(cream)
    pan.add(white_wine)
    pan.stir("to deglaze")
    
    pan.add(mushrooms)
    pan.stir("to combine")
    pan.adjust_seasoning()
    
    return "Mushroom Schnitzel"
}
