{
  "name": "cookbook",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace packages/food-lang && npm run build --workspace apps/web",
    "build:grammar": "npm run build --workspace packages/food-lang",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:push": "npm run db:push --workspace apps/web",
    "db:migrate": "npm run db:migrate --workspace apps/web",
    "db:studio": "npm run db:studio --workspace apps/web",
    "extension:build": "npm run build --workspace apps/extension"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "overrides": {
    "@prisma/client": "5.22.0",
    "prisma": "5.22.0",
    "dompurify": "$dompurify"
  },
  "dependencies": {
    "dompurify": "^3.4.17"
  }
}