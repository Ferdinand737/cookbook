{
  "manifest_version": 3,
  "name": "Cookbook // .food",
  "version": "0.1.0",
  "description": "Convert any recipe page into .food code and save to your Cookbook.",
  "action": { "default_popup": "popup.html", "default_title": "Cookbook" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": ["http://localhost:3000/*", "https://localhost:3000/*"],
  "content_scripts": [
    {
      "matches": ["http://localhost:3000/*", "https://localhost:3000/*"],
      "js": ["content_web.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": { "128": "icons/icon128.png" }
}
